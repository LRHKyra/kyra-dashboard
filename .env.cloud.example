# Cloud deployment environment variables
# Copy to .env or set in your hosting platform (ECS task definition, etc.)

# Required — controls which UI/routes are exposed
DEPLOYMENT_MODE=cloud
NEXT_PUBLIC_DEPLOYMENT_MODE=cloud

# Optional — set when the app is mounted behind a path-prefix gateway
NEXT_PUBLIC_BASE_PATH=/app/dashboard

# Required — HubSpot private app token (read-only CRM access)
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxx
